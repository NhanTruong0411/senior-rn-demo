## 4. Code tối thiểu

```ts
// Pattern cache-first: hiển thị ngay dữ liệu cũ, âm thầm cập nhật ở nền
async function getProducts() {
  const cached = await localDb.getProducts();
  if (cached) renderProducts(cached); // hiển thị ngay, không chờ mạng

  try {
    const fresh = await api.get('/products');
    await localDb.saveProducts(fresh.data);
    renderProducts(fresh.data); // có dữ liệu mới thì cập nhật lại UI
  } catch {
    // mất mạng — vẫn còn dữ liệu cache đang hiển thị, không sao
  }
}
```

```ts
// Sync theo mốc thời gian — chỉ lấy dữ liệu mới hơn lần sync gần nhất
async function syncSince(lastSyncedAt: string) {
  const changes = await api.get(`/products/changes?since=${lastSyncedAt}`);
  await localDb.applyChanges(changes.data);
  await localDb.setLastSyncedAt(new Date().toISOString());
}
```

