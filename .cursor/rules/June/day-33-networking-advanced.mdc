## 4. Code tối thiểu

```ts
// Exponential Backoff — thử lại với thời gian chờ tăng dần
async function fetchWithRetry(url: string, maxRetries = 3): Promise<Response> {
  for (let attempt = 0; attempt <= maxRetries; attempt++) {
    try {
      const res = await fetch(url);
      if (res.ok) return res;
    } catch {
      // lỗi mạng — thử lại nếu còn lượt
    }
    if (attempt < maxRetries) {
      const delay = 2 ** attempt * 1000; // 1s, 2s, 4s...
      await new Promise((r) => setTimeout(r, delay));
    }
  }
  throw new Error('Request failed after retries');
}
```

```ts
// SSE — nhận stream dữ liệu một chiều từ server (ví dụ AI streaming, Day 18)
const eventSource = new EventSource(`${API_BASE_URL}/stream`);
eventSource.onmessage = (event) => {
  appendChunk(event.data); // server đẩy từng đoạn dữ liệu về
};
```

