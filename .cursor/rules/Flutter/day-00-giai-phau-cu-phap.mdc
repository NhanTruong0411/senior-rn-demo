## 6. Ví dụ hoàn chỉnh — có state, chú thích từng dòng

```dart
// 'import' = nhập thư viện (giống import trong JS).
// 'package:flutter/material.dart' = bộ widget Material Design (Google style) của Flutter.
//    → Cung cấp Scaffold, AppBar, Text, Column, ElevatedButton... 
//    → Gần giống việc bạn import { View, Text } from 'react-native'.
import 'package:flutter/material.dart';

// ══════════ WIDGET CÓ STATE — CẦN 2 CLASS ══════════
// Vì sao cần 2 class? Vì Flutter tách:
//   - Class 1 (StatefulWidget): phần CẤU HÌNH (props), bị hủy & tạo lại mỗi khi rebuild.
//   - Class 2 (State):          phần DỮ LIỆU (state), ĐƯỢC GIỮ LẠI xuyên suốt.
// → Đây là lý do state không bị mất khi widget rebuild.
//   (Trong RN, React tự lo việc này ngầm bên trong nên bạn không thấy.)

// ─── CLASS 1: phần khai báo widget ───
class Counter extends StatefulWidget {
  // Constructor. Không có props nào ngoài `key`.
  const Counter({super.key});

  // 'createState()' = hàm BẮT BUỘC của StatefulWidget.
  //                   Nhiệm vụ: tạo ra object State đi kèm.
  // 'State<Counter>' = kiểu trả về: một State gắn với widget Counter.
  // '=> _CounterState()' = arrow function, trả về instance của class State bên dưới.
  @override
  State<Counter> createState() => _CounterState();
}

// ─── CLASS 2: phần chứa state + UI ───
// '_' đầu tên = private, chỉ dùng trong file này.
// 'extends State<Counter>' = đây là State dành riêng cho widget Counter.
class _CounterState extends State<Counter> {

  // BIẾN STATE. Đây chính là `const [count, setCount] = useState(0)` của RN.
  // Khai báo bình thường như biến class, không cần hook.
  int count = 0;

  // Hàm xử lý tăng count. Đặt tên tùy ý.
  void _increment() {
    // 'setState(() { ... })' = báo cho Flutter: "state đã đổi, hãy gọi lại build()".
    //   → Tương đương setCount(count + 1) trong RN.
    //   → BẮT BUỘC phải bọc trong setState, nếu chỉ viết `count++` thì
    //     biến đổi nhưng UI KHÔNG cập nhật (giống mutate state trực tiếp trong React).
    setState(() {
      count++;   // tăng biến state lên 1
    });
  }

  @override
  Widget build(BuildContext context) {
    // 'Column' = xếp các widget con theo chiều DỌC (= flexDirection: 'column' trong RN).
    return Column(
      // 'mainAxisAlignment' = căn theo trục chính (với Column, trục chính là DỌC)
      //                     = justifyContent trong Flexbox.
      // 'MainAxisAlignment.center' = căn giữa theo chiều dọc.
      mainAxisAlignment: MainAxisAlignment.center,

      // 'children' = danh sách widget con (dấu [] = List).
      children: [
        // Widget hiển thị chữ. '$count' nhúng giá trị biến count vào chuỗi.
        Text('Count: $count'),

        // 'ElevatedButton' = nút bấm nổi (Material) = <TouchableOpacity> + style trong RN.
        ElevatedButton(
          // 'onPressed' = callback khi bấm = onPress trong RN.
          //   Truyền thẳng tên hàm `_increment` (không có dấu ngoặc () phía sau,
          //   vì ta truyền THAM CHIẾU hàm, không phải gọi nó ngay).
          onPressed: _increment,

          // 'child' = nội dung bên trong nút (chỉ 1 widget).
          // 'const' phía trước Text = widget này không bao giờ đổi → Flutter tối ưu, không rebuild.
          child: const Text('Tăng'),
        ),
      ],
    );
  }
}
```

