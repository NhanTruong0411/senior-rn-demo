### e) Collection (List/Map) + cú pháp đặc sản Dart

```dart
// ── LIST = mảng. Cú pháp giống JS.
//    '<int>' = kiểu phần tử (giống Array<number> trong TS). Có thể bỏ, Dart tự suy.
final list = [1, 2, 3];
final typedList = <int>[1, 2, 3];

// ── '.map()' giống JS NHƯNG trả về Iterable (lazy), KHÔNG phải List.
//    → PHẢI gọi '.toList()' để biến thành List thật.
//    ⚠️ Đây là lỗi RN dev hay mắc nhất khi mới học Dart!
final doubled = list.map((e) => e * 2).toList();   // [2, 4, 6]
// final wrong = list.map((e) => e * 2);           // ❌ Iterable, không dùng trực tiếp được

// ── '.where()' = filter của JS.
final evens = list.where((e) => e % 2 == 0).toList();   // [2]

// ── SPREAD OPERATOR '...' — giống hệt JS.
final combined = [...list, 4, 5];   // [1, 2, 3, 4, 5]

// ── MAP (dictionary) = object của JS.
//    '<String, dynamic>' = key kiểu String, value kiểu bất kỳ.
//    'dynamic' = kiểu động, tắt type-check (giống `any` trong TS).
final Map<String, dynamic> json = {'id': 1, 'name': 'Nhan'};
print(json['name']);   // Nhan

// ══════════════════════════════════════════════════════════════
// ── COLLECTION-IF & COLLECTION-FOR — ĐẶC SẢN DART
//    Cho phép viết if/for NGAY BÊN TRONG danh sách.
//    Bạn sẽ gặp cái này liên tục khi build UI Flutter.
// ══════════════════════════════════════════════════════════════
final bool isLoggedIn = true;
final items = ['A', 'B'];

final widgets = [
  // Phần tử luôn có
  'Always shown',

  // 'if' ngay trong list: chỉ thêm phần tử này khi điều kiện đúng.
  // → RN tương đương: {isLoggedIn && <Text>Welcome</Text>}
  if (isLoggedIn) 'Welcome back',

  // 'for' ngay trong list: sinh ra nhiều phần tử từ vòng lặp.
  // → RN tương đương: {items.map(item => <Text key={item}>{item}</Text>)}
  for (var item in items) 'Item $item',
];
// Kết quả: ['Always shown', 'Welcome back', 'Item A', 'Item B']

// ── CASCADE OPERATOR '..' — gọi nhiều method/gán nhiều thuộc tính trên CÙNG 1 object.
//    Mỗi '..' trả về chính object đó, nên nối chuỗi được.
//    → Không có tương đương trong JS (JS phải viết nhiều dòng hoặc dùng Object.assign).
final paint = Paint()
  ..color = Colors.red        // gán color
  ..strokeWidth = 4           // gán strokeWidth (vẫn trên object Paint đó)
  ..style = PaintingStyle.stroke;
```

