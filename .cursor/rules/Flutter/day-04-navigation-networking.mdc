## 5. Code tối thiểu — màn hình gọi API hoàn chỉnh

```dart
import 'package:flutter/material.dart';

class UserScreen extends StatelessWidget {
  const UserScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('User')),

      body: FutureBuilder<User>(
        future: fetchUser(1),                  // gọi API
        builder: (context, snap) {             // 'snap' = tên rút gọn của snapshot

          // Đang tải → hiện vòng xoay
          if (snap.connectionState == ConnectionState.waiting) {
            return const Center(child: CircularProgressIndicator());
          }

          // Có lỗi → hiện thông báo
          if (snap.hasError) {
            return Center(child: Text('Lỗi: ${snap.error}'));
          }

          // Thành công → hiện dữ liệu
          final user = snap.data!;             // '!' vì chắc chắn có data ở nhánh này
          return Center(child: Text('Hi ${user.name}'));
        },
      ),
    );
  }
}
```

