### d) Hiển thị 3 trạng thái loading / error / success

```dart
// 'FutureBuilder<User>' = widget tự động lắng nghe 1 Future và rebuild theo trạng thái của nó.
//   '<User>' = kiểu dữ liệu mà Future sẽ trả về.
//   → Không có tương đương chính xác trong RN; gần giống việc bạn tự viết
//     useEffect + useState(loading/data/error).
FutureBuilder<User>(

  // 'future:' = Future cần theo dõi.
  //   ⚠️ LƯU Ý: không gọi trực tiếp fetchUser() ở đây trong widget có state,
  //      vì mỗi lần build() chạy sẽ tạo request mới. Production nên dùng Bloc/Riverpod.
  future: fetchUser(1),

  // 'builder:' = hàm vẽ UI, được gọi lại mỗi khi trạng thái Future đổi.
  //   'snapshot' = object chứa trạng thái hiện tại + dữ liệu/lỗi.
  builder: (context, snapshot) {

    // ── TRẠNG THÁI 1: ĐANG TẢI
    //    'snapshot.connectionState' = trạng thái kết nối của Future.
    //    'ConnectionState.waiting'  = đang chờ kết quả.
    if (snapshot.connectionState == ConnectionState.waiting) {
      // 'CircularProgressIndicator' = vòng xoay loading = <ActivityIndicator> của RN.
      // 'Center' = widget căn giữa con của nó.
      return const Center(child: CircularProgressIndicator());
    }

    // ── TRẠNG THÁI 2: LỖI
    //    'snapshot.hasError' = true nếu Future ném exception.
    if (snapshot.hasError) {
      // 'snapshot.error' = object lỗi. Nhúng vào chuỗi bằng ${...}.
      return Center(child: Text('Lỗi: ${snapshot.error}'));
    }

    // ── TRẠNG THÁI 3: THÀNH CÔNG
    //    'snapshot.data' = dữ liệu trả về, kiểu User? (có thể null).
    //    '!' = khẳng định không null (đến đây thì chắc chắn có data).
    return Center(child: Text('Hi ${snapshot.data!.name}'));
  },
)
```

