### b) go_router — chuẩn production 2026 (hỗ trợ deep link tốt)

```dart
// ══════════ ĐỊNH NGHĨA ROUTER (khai báo 1 lần, thường ở file riêng) ══════════
// Giống việc khai báo Stack.Navigator + linking config trong RN.

final router = GoRouter(
  // 'routes:' = danh sách các màn hình và đường dẫn tương ứng.
  routes: [

    // 'GoRoute' = định nghĩa 1 route.
    GoRoute(
      path: '/',                        // đường dẫn URL của màn này
      // 'builder:' = hàm trả về widget màn hình.
      //   '(_, __)' = 2 tham số (context, state) đều không dùng → đặt tên _ và __.
      builder: (_, __) => const HomeScreen(),
    ),

    GoRoute(
      // ':id' = THAM SỐ ĐỘNG trong đường dẫn.
      //   URL '/product/123' sẽ khớp route này, với id = '123'.
      //   → Tương đương linking config `product/:id` của React Navigation.
      path: '/product/:id',

      builder: (context, state) {
        // 'state.pathParameters' = Map chứa các tham số động trong URL.
        //   Lấy giá trị id ra: state.pathParameters['id']
        //   Kết quả là String? (có thể null) nên thường dùng '!' hoặc gán mặc định.
        final id = state.pathParameters['id']!;

        return ProductScreen(id: id);
      },
    ),
  ],
);

// ══════════ ĐIỀU HƯỚNG ══════════

// 'context.go(...)' = THAY THẾ toàn bộ stack bằng route mới.
//   → Dùng khi chuyển "khu vực" của app (vd sau login vào Home).
context.go('/product/123');

// 'context.push(...)' = ĐẨY THÊM route lên stack (vẫn back về được).
//   → Dùng khi đi sâu vào chi tiết. Tương đương navigation.navigate của RN.
context.push('/product/123');

// 'context.pop()' = quay lại màn trước.
context.pop();
```

| React Navigation | Flutter |
| --- | --- |
| `navigation.navigate('Detail')` | `Navigator.push(...)` / `context.push('/detail')` |
| `navigation.goBack()` | `Navigator.pop(context)` / `context.pop()` |
| `navigation.reset(...)` | `Navigator.pushAndRemoveUntil(...)` / `context.go(...)` |
| Stack Navigator | `Navigator` / `GoRouter` |
| Bottom Tabs | `BottomNavigationBar` + `IndexedStack` |
| `linking` config (deep link) | go_router `path: '/product/:id'` |
| route params | `state.pathParameters` / constructor params |

> **Lợi thế của bạn:** Bạn đã hiểu deep link cold-start vs warm-start, nested navigator, back stack từ kinh nghiệm RN. go_router giải quyết cùng bài toán — chỉ khác API. Nói được điều này lúc phỏng vấn = ghi điểm.

