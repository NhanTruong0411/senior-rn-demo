### c) Bottom Tabs (app CellphoneS chắc chắn có)

```dart
// Widget có state vì cần nhớ tab nào đang được chọn.
class MainScreen extends StatefulWidget {
  const MainScreen({super.key});
  @override
  State<MainScreen> createState() => _MainScreenState();
}

class _MainScreenState extends State<MainScreen> {
  // ── STATE: chỉ số tab đang chọn (0 = tab đầu tiên).
  int _tabIndex = 0;

  // ── Danh sách các màn hình tương ứng từng tab.
  //    'final' vì list này không đổi.
  final _screens = const [
    HomeScreen(),
    ProfileScreen(),
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(

      // ── 'IndexedStack' = widget hiển thị 1 con tại vị trí `index`,
      //    NHƯNG GIỮ NGUYÊN state của tất cả các con khác (chúng vẫn tồn tại, chỉ bị ẩn).
      //    → Đây là lý do dùng IndexedStack thay vì đổi thẳng widget:
      //      chuyển tab qua lại KHÔNG mất scroll position, không gọi lại API.
      //    → Tương đương hành vi mặc định của Tab Navigator trong RN.
      body: IndexedStack(
        index: _tabIndex,          // hiển thị con tại vị trí này
        children: _screens,        // tất cả màn hình (đều được giữ trong bộ nhớ)
      ),

      // ── Thanh tab dưới cùng.
      bottomNavigationBar: BottomNavigationBar(
        // 'currentIndex:' = tab nào đang được highlight.
        currentIndex: _tabIndex,

        // 'onTap:' = callback khi user bấm 1 tab.
        //   'i' = chỉ số tab được bấm (Flutter tự truyền vào).
        //   Gọi setState để cập nhật _tabIndex → build() chạy lại → đổi tab.
        onTap: (i) => setState(() => _tabIndex = i),

        // 'items:' = danh sách các nút tab.
        items: const [
          BottomNavigationBarItem(
            icon: Icon(Icons.home),    // 'Icons.home' = icon có sẵn của Material
            label: 'Home',             // chữ dưới icon
          ),
          BottomNavigationBarItem(
            icon: Icon(Icons.person),
            label: 'Profile',
          ),
        ],
      ),
    );
  }
}
```

